# CommuteIQ Environment Configuration Template

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=commuteiq
POSTGRES_USER=commuteiq
POSTGRES_PASSWORD=commuteiq_secret

# Cache & Rate Limiting (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Event Bus (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

# Service-to-Service Security
COMMUTEIQ_SHARED_SECRET=commuteiq-dev-secret-key-32chars

# AI Service Settings
AI_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=replace_with_your_api_key

# Optional Alternative Providers
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Vector Database (faiss | pinecone | weaviate)
VECTOR_BACKEND=faiss
PINECONE_API_KEY=
PINECONE_INDEX_NAME=commuteiq
WEAVIATE_URL=http://localhost:8085

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ports
GATEWAY_PORT=8080
AI_PORT=8000
WEB_PORT=3000
