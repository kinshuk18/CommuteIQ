#!/bin/sh
# Maven Wrapper bootstrap script — downloaded from Apache Maven project
# Do not edit this file manually.
set -e

MAVEN_VERSION=3.9.9
MAVEN_DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip"
MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}-bin"

if [ -d "${MAVEN_HOME}" ] && [ -f "${MAVEN_HOME}/bin/mvn" ]; then
    exec "${MAVEN_HOME}/bin/mvn" "$@"
fi

echo "Downloading Maven ${MAVEN_VERSION} …"
mkdir -p "${MAVEN_HOME}"
TMP_ZIP=$(mktemp /tmp/maven-XXXXXX.zip)
curl -fsSL "${MAVEN_DIST_URL}" -o "${TMP_ZIP}"
unzip -q "${TMP_ZIP}" -d "${HOME}/.m2/wrapper/dists/"
rm "${TMP_ZIP}"
# The unzipped folder is named apache-maven-X.Y.Z, rename to our expected path
UNZIPPED="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
if [ -d "${UNZIPPED}" ] && [ ! -d "${MAVEN_HOME}" ]; then
    mv "${UNZIPPED}" "${MAVEN_HOME}"
fi
exec "${MAVEN_HOME}/bin/mvn" "$@"
